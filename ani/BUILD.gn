import("//build/config/components/ets_frontend/ets2abc_config.gni")
import("//build/ohos.gni")

ohos_shared_library("intl_ani") {
  include_dirs = [
    "./include",
    "../frameworks/intl/include",
  ]
  sources = [ "./native/intl_ani.cpp" ]
  deps = [ "../frameworks/intl:intl_util" ]
  external_deps = [
    "icu:shared_icuuc",
    "runtime_core:ani",
  ]
  use_exceptions = true
  subsystem_name = "global"
  part_name = "i18n"
}

generate_static_abc("intl_abc") {
  dst_file = "$target_out_dir/intl_ani.abc"
  arktsconfig = "./arktsconfig_intl.json"
  out_puts = [ "$target_out_dir/intl" ]
}

group("ani_package_intl") {
  deps = [
    ":intl_abc",
    ":intl_ani",
  ]
}

ohos_shared_library("i18n_ani") {
  include_dirs = [
    "./include",
    "../frameworks/intl/include/",
  ]
  sources = [ "./native/i18n_ani.cpp" ]
  deps = [ "../frameworks/intl:intl_util" ]
  external_deps = [ "runtime_core:ani" ]
  subsystem_name = "global"
  part_name = "i18n"
}

generate_static_abc("i18n_abc") {
  dst_file = "$target_out_dir/i18n_ani.abc"
  arktsconfig = "./arktsconfig_i18n.json"
  out_puts = [ "$target_out_dir/i18n" ]
}

group("ani_package_i18n") {
  deps = [
    ":i18n_abc",
    ":i18n_ani",
  ]
}
